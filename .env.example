# Feed the HUD from the built-in simulation (default when unset).
VITE_JHARVIS_SOURCE=mock

# Point it at a real jharvis backend instead. The adapter expects a
# `JharvisSnapshot`-shaped document at GET {VITE_JHARVIS_URL}/snapshot and
# posts operator commands to POST {VITE_JHARVIS_URL}/command.
# VITE_JHARVIS_SOURCE=jharvis
# VITE_JHARVIS_URL=http://localhost:8080
# VITE_JHARVIS_WS=ws://localhost:8080/stream
